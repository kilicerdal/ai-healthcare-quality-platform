{
  "type": "object",
  "required": [
    "claimId",
    "memberId",
    "providerId",
    "serviceDate",
    "diagnosisCode",
    "claimAmount",
    "status",
    "createdAt"
  ],
  "properties": {
    "claimId": {
      "type": "string",
      "pattern": "^CLM-[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "memberId": {
      "type": "string"
    },
    "providerId": {
      "type": "string"
    },
    "serviceDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "format": "date"
    },
    "diagnosisCode": {
      "type": "string"
    },
    "claimAmount": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "status": {
      "type": "string",
      "enum": ["RECEIVED"]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
